          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics": {
      "get": {
        "summary": "Choose accurate lyrics from seven providers; genuine word timestamps when available",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics/all": {
      "get": {
        "summary": "All lyric sources",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
