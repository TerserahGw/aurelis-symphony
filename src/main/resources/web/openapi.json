{
  "openapi": "3.0.3",
  "info": {
    "title": "Aurelis Symphony API",
    "version": "2.7.1",
    "description": "Aurelis Symphony 2.7: optional CJK lyric romanization, first-party playback URL resolution, HTTP Range audio relay for accessible streams, experimental YouTube audio, seven lyric sources, and ambient motion. No DRM/anti-bot circumvention."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
