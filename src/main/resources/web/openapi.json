          "503": {
            "description": "Upstream unavailable"
          }
        }
      },
      "put": {
        "summary": "Update private cloud library",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved"
          }
        }
      }
    },
    "/api/v1/tracks/{id}": {
      "get": {
        "summary": "Bundled track by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
