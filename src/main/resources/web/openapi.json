{
  "openapi": "3.0.3",
  "info": {
    "title": "Aurelis Symphony API",
    "version": "1.0.0",
    "description": "Personal music discovery and multi-source lyrics API. External availability is not guaranteed."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Aurelis"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Server status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Capabilities and sources",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/catalog": {
      "get": {
        "summary": "Browse local, playable catalog",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/tracks/{id}": {
      "get": {
        "summary": "Local track details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "summary": "Search with NewPipeExtractor",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "catalog",
                "youtube",
                "soundcloud",
                "bandcamp",
                "peertube",
                "mediaccc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/info": {
      "get": {
        "summary": "Resolve external media metadata and audio choices",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics/sources": {
      "get": {
        "summary": "List all supported lyric integrations",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics": {
      "get": {
        "summary": "Get best matched lyrics including lines and word timestamps",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics/all": {
      "get": {
        "summary": "Return results of each lyric provider (best-effort)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics/lrc": {
      "get": {
        "summary": "Return LRC or Enhanced LRC text",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lrc",
                "enhanced"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/library": {
      "get": {
        "summary": "Load token-private library; requires cloud library enabled",
        "security": [
          {
            "LibraryToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      },
      "put": {
        "summary": "Atomically replace token-private library JSON",
        "security": [
          {
            "LibraryToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LibraryToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "64-character hexadecimal secret chosen by the client. Use HTTPS on public deployments."
      }
    }
  }
}
