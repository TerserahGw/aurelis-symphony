    },
    "/api/v1/search": {
      "get": {
        "summary": "Search music metadata",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/recommendations": {
      "get": {
        "summary": "Artist-and-vibe radio: title deduplication and artist diversity",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recent",
            "in": "query",
            "description": "JSON array of recent tracks",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "queued",
            "in": "query",
            "description": "JSON array of already queued tracks",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mood",
            "in": "query",
            "description": "Mood or genre hint",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "familiar, balanced or discover",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "album",
            "in": "query",
            "description": "Album of anchor track",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "liked",
            "in": "query",
            "description": "URL-encoded JSON array of locally liked tracks (id, title, artist, album). Optional; no server account.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/info": {
      "get": {
        "summary": "Unverified YouTube direct-audio descriptor",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics/sources": {
      "get": {
        "summary": "List all seven lyric sources and available timing capabilities",
        "parameters": [],
