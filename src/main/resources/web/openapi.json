{
  "openapi": "3.0.3",
  "info": {
    "title": "Aurelis Symphony API",
    "version": "2.3.0",
    "description": "Aurelis Symphony 2.3: YouTube-only metadata, artist-and-vibe radio, Enhanced LRC word timing, opt-in translation, unofficial experimental audio playback."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Service health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Backend and capabilities",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/catalog": {
      "get": {
        "summary": "Bundled original songs",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "summary": "Search music metadata",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/recommendations": {
      "get": {
        "summary": "Artist-and-vibe radio: title deduplication and artist diversity",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recent",
            "in": "query",
            "description": "JSON array of recent tracks",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "queued",
            "in": "query",
            "description": "JSON array of already queued tracks",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mood",
            "in": "query",
            "description": "Mood or genre hint",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "familiar, balanced or discover",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "album",
            "in": "query",
            "description": "Album of anchor track",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/info": {
      "get": {
        "summary": "Unverified YouTube direct-audio descriptor",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics/sources": {
      "get": {
        "summary": "Available lyrics providers",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics": {
      "get": {
        "summary": "Best matching lyrics",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics/all": {
      "get": {
        "summary": "All lyric sources",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/lyrics/lrc": {
      "get": {
        "summary": "Export LRC",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/library": {
      "get": {
        "summary": "Optional cloud library",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      },
      "put": {
        "summary": "Update private cloud library",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved"
          }
        }
      }
    },
    "/api/v1/tracks/{id}": {
      "get": {
        "summary": "Bundled track by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Track"
          }
        }
      }
    },
    "/api/v2/status": {
      "get": {
        "summary": "Experimental audio backend status",
        "responses": {
          "200": {
            "description": "Runtime stream status"
          }
        }
      }
    },
    "/api/v2/home": {
      "get": {
        "summary": "Metadata-based recommendations using client-supplied recent history",
        "responses": {
          "200": {
            "description": "Search suggestions or original fallback"
          }
        },
        "parameters": [
          {
            "name": "recent",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded array of recent tracks"
          },
          {
            "name": "mood",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "balanced",
                "familiar",
                "discover"
              ]
            }
          }
        ]
      }
    },
    "/api/v2/audio/{videoId}": {
      "get": {
        "summary": "Experimental direct-audio byte relay, no DRM or access bypass",
        "parameters": [
          {
            "name": "videoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "probe",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Read only initial bytes and return diagnostic JSON"
          }
        ],
        "responses": {
          "200": {
            "description": "Unseekable audio stream"
          },
          "206": {
            "description": "Partial audio stream"
          },
          "403": {
            "description": "Streaming disabled"
          },
          "424": {
            "description": "Experimental audio unavailable or blocked by upstream"
          }
        }
      }
    },
    "/api/v2/translate": {
      "post": {
        "summary": "Opt-in lyric translation via MyMemory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "texts"
                ],
                "properties": {
                  "texts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "maxLength": 250
                    }
                  },
                  "target": {
                    "type": "string",
                    "enum": [
                      "id",
                      "en"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Translations"
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
