    "/api/v1/lyrics/lrc": {
      "get": {
        "summary": "Export LRC",
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
    "/api/v1/library": {
      "get": {
        "summary": "Optional cloud library",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      },
      "put": {
        "summary": "Update private cloud library",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved"
          }
        }
      }
    },
    "/api/v1/tracks/{id}": {
      "get": {
        "summary": "Bundled track by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Track"
          }
        }
      }
    },
    "/api/v2/status": {
      "get": {
        "summary": "Experimental audio backend status",
        "responses": {
          "200": {
            "description": "Runtime stream status"
          }
        }
      }
    },
    "/api/v2/home": {
      "get": {
        "summary": "Metadata-based recommendations using client-supplied recent history",
        "responses": {
          "200": {
            "description": "Search suggestions or original fallback"
          }
        },
        "parameters": [
          {
            "name": "recent",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded array of recent tracks"
          },
          {
            "name": "mood",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "balanced",
                "familiar",
                "discover"
              ]
            }
          },
          {
            "name": "liked",
            "in": "query",
            "description": "URL-encoded JSON array of locally liked tracks (id, title, artist, album). Optional; no server account.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v2/audio/{videoId}": {
      "get": {
        "summary": "Experimental direct-audio relay and optional download; may fail due to anti-bot",
        "parameters": [
          {
            "name": "videoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "probe",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Read only initial bytes and return diagnostic JSON"
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "description": "Set 1 to request Content-Disposition attachment on a playable stream. Does not bypass upstream restrictions.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": false,
            "description": "Suggested audio download filename (ASCII-sanitized server-side).",
            "schema": {
              "type": "string",
              "maxLength": 130
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audio bytes when streaming without range (or JSON when ?probe=1)"
          },
          "206": {
            "description": "Partial binary audio response with Content-Range"
          },
          "403": {
            "description": "Streaming disabled"
          },
          "424": {
            "description": "Experimental audio unavailable or blocked by upstream"
          }
        },
        "description": "GET :videoId returns binary audio with Range/206 if and only if the upstream permits it. GET ?probe=1 returns a short JSON byte preflight on success or HTTP 424 JSON diagnostic. YouTube playback is experimental and can fail at any time; no bypasses."
      }
    },
    "/api/v2/translate": {
      "post": {
        "summary": "Opt-in lyric translation via MyMemory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "texts"
                ],
                "properties": {
                  "texts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "maxLength": 250
                    }
                  },
                  "target": {
                    "type": "string",
                    "enum": [
                      "id",
                      "en"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Translations"
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v2/playback/{id}": {
      "get": {
        "summary": "Resolve track ID to an Aurelis audio stream URL (does not check YouTube playback)",
        "description": "Bundled original tracks provide confirmed static MP3 paths; YouTube IDs return experimental internal streaming and probe URLs. This is a URL resolver, not an upstream availability guarantee.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "demo-aether or YouTube videoId or yt-videoId"
          }
        ],
        "responses": {
          "200": {
            "description": "Descriptor JSON with streamUrl and optional probeUrl"
          },
          "400": {
            "description": "Invalid track ID"
          },
          "404": {
            "description": "Unknown track"
          }
        }
      }
    },
    "/api/v2/romanize": {
      "post": {
        "summary": "Romanize Japanese, Korean or Mandarin lyric lines",
        "description": "Dictionary-based Japanese Kanji reading, Korean Revised Romanization or Mandarin Pinyin. Returns completeness per line. Best-effort for names and polyphonic characters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "texts"
                ],
                "properties": {
                  "texts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 60,
                    "items": {
                      "type": "string",
                      "maxLength": 320
                    }
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "ja",
                      "ko",
                      "zh"
                    ],
                    "default": "auto"
                  }
                }
              },
              "example": {
                "texts": [
                  "今日はいい天気",
                  "音楽"
                ],
                "language": "ja"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "lines with romanized text and completeness flags"
          },
          "400": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/playlists/import": {
      "get": {
        "summary": "Import public or unlisted YouTube playlist metadata",
        "description": "Preserves source order and duplicate tracks. Skips unplayable entries. limit caps entries scanned, not successful tracks. Relative playback links do not guarantee streaming.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "example": "https://youtube.com/playlist?list=PLEBFqiHTFkcY_ZCW2Sro17E5b_TCFIbZ3"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Playlist metadata, tracks, count, scanned, skipped and truncated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "playlist",
                    "tracks",
                    "count",
                    "scanned",
                    "skipped",
                    "truncated"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "playlist": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "author": {
                          "type": "string"
                        },
                        "artwork": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "provider": {
                          "type": "string"
                        },
                        "totalItemsText": {
                          "type": "string"
                        }
                      }
                    },
                    "tracks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "videoId": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "artist": {
                            "type": "string"
                          },
                          "duration": {
                            "type": "integer"
                          },
                          "position": {
                            "type": "integer"
                          },
                          "artwork": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "streamUrl": {
                            "type": "string"
                          },
                          "playbackUrl": {
                            "type": "string"
                          },
                          "probeUrl": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "scanned": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "integer"
                    },
                    "truncated": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL or limit"
          },
          "429": {
            "description": "Rate limited or busy"
          },
          "503": {
            "description": "Playlist unavailable or upstream error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
