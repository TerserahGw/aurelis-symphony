{
  "openapi": "3.0.3",
  "info": {
    "title": "Aurelis Symphony API",
    "version": "2.1.0",
    "description": "Aurelis Symphony 2.1 — metadata search with optional experimental unofficial YouTube.js direct-audio relay, plus original licensed media. Not an official YouTube playback integration."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
