          }
        }
      }
    },
    "/api/v2/status": {
      "get": {
        "summary": "Experimental audio backend status",
        "responses": {
          "200": {
            "description": "Runtime stream status"
          }
        }
      }
    },
    "/api/v2/home": {
      "get": {
        "summary": "Suggested tracks based on non-personalized music search",
        "responses": {
          "200": {
            "description": "Search suggestions or original fallback"
          }
        }
      }
    },
    "/api/v2/audio/{videoId}": {
      "get": {
        "summary": "Experimental direct-audio byte relay, no DRM or access bypass",
        "parameters": [
          {
            "name": "videoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unseekable audio stream"
          },
          "206": {
            "description": "Partial audio stream"
          },
          "403": {
            "description": "Streaming disabled"
          },
          "502": {
            "description": "Audio unavailable or upstream range unsupported"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
