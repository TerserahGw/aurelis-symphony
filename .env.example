HOST=0.0.0.0
PORT=8080
SEARCH_BACKEND=youtubei
AURELIS_DIRECT_AUDIO=true
# Deciphering requires an upstream script evaluator; enable only if you accept the security/terms risks.
AURELIS_STREAM_EVAL=false
AURELIS_MAX_STREAMS=5
YOUTUBE_API_KEY=
AURELIS_CLOUD_LIBRARY=false
AURELIS_DATA_DIR=./data
AURELIS_CORS_ORIGIN=
NODE_OPTIONS=--max-old-space-size=192
