HOST=0.0.0.0
PORT=8080
SEARCH_BACKEND=youtubei
AURELIS_DIRECT_AUDIO=true
AURELIS_YTDL_FALLBACK=true
# YouTube.js may require signature deciphering. Uses a bounded Node VM, not a complete security boundary.
# Set false to disable dynamic upstream player script execution. Availability may fall.
AURELIS_STREAM_EVAL=false
AURELIS_MAX_STREAMS=5
YOUTUBE_API_KEY=
AURELIS_CLOUD_LIBRARY=false
AURELIS_DATA_DIR=./data
AURELIS_CORS_ORIGIN=
NODE_OPTIONS=--max-old-space-size=192

# Optional administrator-owned/licensed audio; exact video ID filenames or trusted HTTPS origin.
AURELIS_AUDIO_DIR=
AURELIS_AUDIO_ORIGIN=
AURELIS_AUDIO_ORIGIN_TOKEN=

# Optional private mode for authorized account/content only. Never commit secrets.
AURELIS_YOUTUBE_COOKIE_ENABLED=false
AURELIS_YOUTUBE_COOKIE=
AURELIS_AUDIO_PASSWORD=
# Optional anonymous resolver, no effect in private-cookie mode.
AURELIS_YTDLP_FALLBACK=false
